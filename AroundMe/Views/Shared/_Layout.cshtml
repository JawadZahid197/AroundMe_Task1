
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AroundMe</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark" style="background:#1f6f5c;">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">📍 AroundMe</a>

                <div class="ms-auto d-flex gap-2">
                    @if (!User.Identity!.IsAuthenticated)
                    {
                        <a class="btn btn-outline-light" asp-controller="Account" asp-action="Login">Login</a>
                        <a class="btn btn-light" asp-controller="Account" asp-action="Register">Sign Up</a>
                    }
                    else
                    {
                        <a class="btn btn-warning" asp-controller="Places" asp-action="Create">+ Share a Place</a>
                        <span class="text-white align-self-center">@User.Identity?.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="btn btn-danger">Logout</button></form>
                    }
                </div>
            </div>
        </nav>
    </header>

    @await RenderSectionAsync("PageBanner", required: false)

    <div class="container my-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="text-center py-3 bg-light mt-5">
        &copy; 2026 AroundMe · <a asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>