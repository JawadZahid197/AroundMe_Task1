@model AroundMe.ViewModels.LoginViewModel
@{ ViewData["Title"]="Login"; }
<div class="mx-auto mt-4" style="max-width:450px"><h3 class="mb-4 text-center">Login</h3><form asp-action="Login" method="post"><input asp-for="ReturnUrl" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-2"><input asp-for="Email" class="form-control" placeholder="Email"/><span asp-validation-for="Email" class="text-danger"></span></div><div class="mb-2"><input asp-for="Password" class="form-control" type="password" placeholder="Password"/><span asp-validation-for="Password" class="text-danger"></span></div><button class="btn btn-success w-100 mt-2" type="submit">Login</button></form><p class="mt-3 text-center">New here? <a asp-action="Register">Sign up</a></p></div>
