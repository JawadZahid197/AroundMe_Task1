@model AroundMe.ViewModels.RegisterViewModel
@{ ViewData["Title"]="Sign Up"; }
<div class="mx-auto mt-4" style="max-width:450px"><h3 class="mb-4 text-center">Create Account</h3><form asp-action="Register" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-2"><input asp-for="FullName" class="form-control" placeholder="Full Name"/><span asp-validation-for="FullName" class="text-danger"></span></div><div class="mb-2"><input asp-for="Username" class="form-control" placeholder="Username"/><span asp-validation-for="Username" class="text-danger"></span></div><div class="mb-2"><input asp-for="City" class="form-control" placeholder="City (optional)"/><span asp-validation-for="City" class="text-danger"></span></div><div class="mb-2"><input asp-for="Email" class="form-control" placeholder="Email"/><span asp-validation-for="Email" class="text-danger"></span></div><div class="mb-2"><input asp-for="Password" type="password" class="form-control" placeholder="Password"/><span asp-validation-for="Password" class="text-danger"></span></div><div class="mb-2"><input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Confirm Password"/><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div><button type="submit" class="btn btn-success w-100 mt-2">Sign Up</button></form><p class="mt-3 text-center">Already have an account? <a asp-action="Login">Login</a></p></div>
