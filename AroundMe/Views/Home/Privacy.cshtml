@{
    ViewData["Title"] = "Privacy Policy";
}

@section Styles {
    <style>
        .privacy-content { max-width: 800px; margin: auto; line-height: 1.8; }
    </style>
}

@section PageBanner {
    <div class="bg-light py-4 text-center">
        <h1>Privacy Policy</h1>
        <p class="text-muted mb-0">How AroundMe handles the information you share</p>
    </div>
}

<div class="privacy-content">
    <h2>Information we collect</h2>
    <p>When you register, we collect your name, username, email and optional city. When you share a place, we store the place details and any photo you upload.</p>

    <h2>How we use it</h2>
    <p>We use account details for authentication and place details to show community recommendations. Place posts display your username publicly.</p>

    <h2>Security</h2>
    <p>Passwords are managed by ASP.NET Core Identity and are not stored as plain text. Please do not upload sensitive personal information in place descriptions or images.</p>

    <h2>Contact and requests</h2>
    <p>For questions about your information or a request to remove content, contact the AroundMe project administrator through your university project team.</p>

    <p class="text-muted small">Coursework demonstration policy. Review and replace with a complete legal policy before any public production launch.</p>
</div>
