@model AroundMe.ViewModels.HomeViewModel
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Home";

    string Emoji(string category) => category switch
    {
        "Cafe" => "☕",
        "Study Spot" => "📚",
        "Restaurant" => "🍽️",
        "Park" => "🌳",
        "Shopping" => "🛍️",
        _ => "📍"
    };

    string Short(string text) => text.Length > 90 ? text.Substring(0, 90) + "..." : text;
}

<!-- HERO -->
<section class="hero text-center text-white">
    <h1 class="display-5 fw-bold">Discover places around you</h1>
    <p class="lead mb-4">Cafes, study spots, parks and hidden gems, recommended by people nearby.</p>

    <form method="get" class="search-box mx-auto">
        <div class="input-group input-group-lg">
            <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="Search a place, area or keyword..." />
            @if (Model.CategoryId != 0)
            {
                <input type="hidden" name="CategoryId" value="@Model.CategoryId" />
            }
            <button type="submit" class="btn btn-warning px-4">🔍 Search</button>
        </div>
    </form>

    <div class="stats d-flex justify-content-center gap-4 mt-4">
        <div><span class="stat-num">@Model.TotalPlaces</span><br />Places shared</div>
        <div><span class="stat-num">@Model.TotalUsers</span><br />Members</div>
    </div>
</section>

<!-- CATEGORY CHIPS -->
<div class="chips d-flex flex-wrap justify-content-center gap-2 my-4">
    <a asp-controller="Home" asp-action="Index" asp-route-search="@Model.Search"
       class="chip @(Model.CategoryId == 0 ? "active" : "")">✨ All</a>

    @foreach (var c in Model.Categories)
    {
        <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@c.CategoryId" asp-route-search="@Model.Search"
           class="chip @(Model.CategoryId == c.CategoryId ? "active" : "")">
            @Emoji(c.CategoryName) @c.CategoryName
        </a>
    }
</div>

<!-- PLACE CARDS -->
@if (Model.Places.Count == 0)
{
    <div class="empty text-center py-5">
        <div class="empty-icon">🗺️</div>
        <h4 class="mt-3">Koi place nahi mili</h4>
        <p class="text-muted">Search ya category badal kar dekho, ya khud pehli recommendation share karo.</p>
       @if (!User.Identity!.IsAuthenticated)
        {
            <a class="btn btn-success" asp-controller="Account" asp-action="Register">Join AroundMe</a>
        }
        else
        {
            <a class="btn btn-success" asp-controller="Places" asp-action="Create">+ Share a Place</a>
        }
    </div>
}
else
{
    <div class="row g-4">
        @{ int i = 0; }
        @foreach (var p in Model.Places)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="place-card card h-100 border-0 shadow-sm" style="animation-delay:@(i * 80)ms">
                    <div class="place-img">
                        @if (!string.IsNullOrEmpty(p.ImagePath))
                        {
                            <img src="@Url.Content("~/" + p.ImagePath)" alt="@p.PlaceName" />
                        }
                        else
                        {
                            <div class="img-fallback">@Emoji(p.CategoryName)</div>
                        }
                        <span class="badge cat-badge">@Emoji(p.CategoryName) @p.CategoryName</span>
                    </div>

                    <div class="card-body">
                        <h5 class="card-title fw-bold mb-1">@p.PlaceName</h5>
                        <p class="text-muted small mb-2">📍 @p.Location</p>
                        <p class="card-text">@Short(p.Description)</p>
                    </div>

                    <div class="card-footer bg-white border-0 d-flex justify-content-between align-items-center pb-3">
                        <small class="text-muted">by <strong>@p.Username</strong> · ❤️ @p.LikeCount</small>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-view">View →</a>
                    </div>
                </div>
            </div>
            i++;
        }
    </div>
}

<!-- HOW IT WORKS -->
<section class="how mt-5 pt-4">
    <h3 class="text-center fw-bold mb-4">How AroundMe works</h3>
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="how-card">
                <div class="how-icon">🔎</div>
                <h5>Explore</h5>
                <p class="text-muted mb-0">Search places or filter by category to find what you need.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="how-card">
                <div class="how-icon">📸</div>
                <h5>Share</h5>
                <p class="text-muted mb-0">Found a great spot? Post it with photos and a short description.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="how-card">
                <div class="how-icon">🔖</div>
                <h5>Save</h5>
                <p class="text-muted mb-0">Like, comment and bookmark places to visit later.</p>
            </div>
        </div>
    </div>
</section>